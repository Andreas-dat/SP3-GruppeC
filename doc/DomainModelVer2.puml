@startuml
'https://plantuml.com/sequence-diagram

object service
object media
object user
object profile
object movie
object series
object season
object episodes
object login
'object child
object info
object category
object plantToWatch
object hasWatched

service *-- "1..*" media
service *-- "1..*" user
user *-- "1..6" profile
user *-- "1" login
'profiles *-- child
profile *-- "*" plantToWatch
profile *-- "*" hasWatched

info o-- "1..*" category
media <|-- movie
media <|-- series
media *-- info
series *-- "1..*" season
season *-- "1..*" episodes


@enduml