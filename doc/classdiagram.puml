@startuml


class Main
class Service{
-String name
-User currentUser
-ArrayList<Media> media
-ArrayList<User> users
+void startService()
+User login()
+void logout()
+void registerUser()
-void loadData()
-void loadMedia()
-void loadUsers()

-void createUser(String name, String username, String password, String email, String dateOfBirth)
}

abstract class Media {
-ArrayList<Category> categories
-String title
-double rating
-int releaseYear
-int ID
-{static} int idCount
}

class Movie {
}

class Series {
-int endOfRelease
-ArrayList<Season> seasons
}

interface Watchable {
-void play()
}

class Season {
-ArrayList<Episode> episodes
}
class Episode {

}
class User {
-ArrayList<Profile> profiles
-Profile currentProfile
-String name
-String username
-String password
-String email
-String dateOfBirth
-void createProfile(nickName, ArrayList<Media> planToWatch, ArrayList<Media> hasWatched)
+void changePassword()
+void changeUsername()
+void changeMail()
-void loadProfiles()
+void changeProfile()
+void changeNickName()
+void changeChildStatus()
+void deleteProfile()
}


class Profile {
-ArrayList<Media> planToWatch
-ArrayList<Media> hasWatched
-String nickName
+void addToList()
+void removeFromList()



}

class Logic {
+ArrayList<String> Search()

}

enum Category {
ACTION
ADVENTURE
ANIMATION
BIOGRAPHY
COMEDY
CRIME
DOCUMENTARY
DRAMA
FAMILY
FANTASY
FILM-NOIR
HISTORY
HORROR
MUSIC
MUSICAL
MYSTERY
ROMANCE
SCI-FI
SPORT
TALK-SHOW
THRILLER
WAR
WESTERN
}

package "util" {
class TextUI {
-Scanner scan
{static} +void displayList(ArrayList<String> list, String msg)
{static} +int promptNumeric(String msg)
{static} +boolean promptBinary(String msg)
{static} +void displayMessage(String msg)
{static}
}

class FileIO {
{static} +ArrayList<String> readData(String path)
{static} +void saveData(ArrayList<String> data, String path, String header)
}
}

Main *-- Service
Service *-- Media
Media *-- Category
Media <|-- Movie
Media <|-- Series
Series *-- Season
Season *-- Episode
Service *-- Logic

'Service *-- TextUI
'Service *-- FileIO

Service *-- User
User *-- Profile

Watchable <|.. Movie
Watchable <|.. Series


@enduml