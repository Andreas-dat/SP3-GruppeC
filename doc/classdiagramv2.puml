@startuml


class Main

class Service{
-String name
-User currentUser
-ArrayList<Media> media
-ArrayList<User> users
-ServiceState state
+Service(String)
-void logout()
+void mainMenu()
+void mediaListMenu(ArrayList<Media>)
+void profileMenu()
+void runService()
+void searchMenu()
+void startMenu()
+void startService()
+void watchableMediaMenu()
}

class UserService {
-User current
-boolean checkUser(String, String, ArrayList<User>)
-void createUser(String, String, String, String, int, ArrayList<User>)
-int getUserBirthYear()
-String getUserMail()
-String getUserPassword()
-String getUserName(ArrayList<User>)
+void registerUser(ArrayList<User>
+User userLogin(int, ArrayList<User>)
}

class LoadManager {
-ArrayList<Media> convertIDToMedia(String, ArrayList<Media>)
-ArrayList<Categories> findCategories(String)
-int findEndOfRelease(String)
-ArrayList<Integer> findEpisodesInSeason(String)
+void loadMedia(ArrayList<Media>, String, String)
+void loadProfiles(User, ArrayList<Media>)
+ArrayList<User> loadUsers()
}

class SaveManager {
+void saveProfiles(User)
+void saveUsers(ArrayList<Users>
}

class Search {
+{static} ArrayList<Media> searchByRating(ArrayList<Media>)
+{static} ArrayList<Media> searchByCategory(ArrayList<Media>)
+{static} ArrayList<Media> searchByDecade(ArrayList<Media>)
+{static} ArrayList<Media> searchByTitle(ArrayList<Media>)
+{static} ArrayList<Media> searchByYear(ArrayList<Media>)
}

class MenuOptions {
+{static} ArrayList<String> mainMenu()
+{static} ArrayList<String> mediaMenu()
+{static} ArrayList<String> profileMenu()
+{static} ArrayList<String> searchMenu()
+{static} ArrayList<String> startMenu()

}

abstract class Media {
-ArrayList<Category> categories
-String title
-double rating
-int releaseYear
-int ID
-{static} int idCount
+Media(String, ArrayList<Categories>, int, double)
}

class Movie {
}

class Series {
-int endOfRelease
-ArrayList<Integer> episodesInSeason
}

interface Watchable {
-void play()
}

class User {
-ArrayList<Profile> profiles
-String name
-String username
-String password
-String email
-String dateOfBirth
-void createProfile(nickName, ArrayList<Media> planToWatch, ArrayList<Media> hasWatched)
}
class Profile {
-ArrayList<Media> planToWatch
-ArrayList<Media> hasWatched
-String nickName
}

enum Category {
ACTION
ADVENTURE
ANIMATION
BIOGRAPHY
COMEDY
CRIME
DOCUMENTARY
DRAMA
FAMILY
FANTASY
FILM-NOIR
HISTORY
HORROR
MUSIC
MUSICAL
MYSTERY
ROMANCE
SCI-FI
SPORT
TALK-SHOW
THRILLER
WAR
WESTERN
}

enum ServiceState {
EXIT
MAIN_MENU
PROFILE_MENU
SEARCH_MENU
START_MENU
}

package "util" {
class TextUI {
-Scanner scan
{static} +void displayList(ArrayList<String> list, String msg)
{static} +int promptNumeric(String msg)
{static} +boolean promptBinary(String msg)
{static} +void displayMessage(String msg)
{static}
}

class FileIO {
{static} +ArrayList<String> readData(String path)
{static} +void saveData(ArrayList<String> data, String path, String header)
}
}

Main *-- Service
Service *-- Media
Media *-- Category
Media <|-- Movie
Media <|-- Series


Service *-- User
Service *-- ServiceState
User *-- Profile

Watchable <|.. Movie
Watchable <|.. Series


@enduml